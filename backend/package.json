{
  "name": "parcelpilot-backend",
  "version": "2.0.0",
  "private": true,
  "description": "ParcelPilot Support Copilot API on AWS Lambda",
  "main": "src/handlers/index.js",
  "scripts": {
    "ingest": "node scripts/ingest.js",
    "ingest:upload": "node scripts/ingest.js --upload",
    "dev": "node scripts/local.js",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node --test test/integration.test.js",
    "seed:users": "node scripts/seed-users.js",
    "test:env": "node scripts/test-env.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@openai/agents": "^0.1.0",
    "exceljs": "^4.4.0",
    "openai": "^4.77.0",
    "pdf-parse": "1.1.1",
    "zod": "^3.23.8",
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0"
  },
  "devDependencies": {
    "dotenv": "^17.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
