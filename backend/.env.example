# Local development only. Production reads the OpenRouter key from SSM Parameter Store
# (SecureString) at /parcelpilot/<stage>/openrouter-api-key and never from a file.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4.1-mini
APP_URL=http://localhost:5173
# Simulated Cognito claims for scripts/local.js
DEV_GROUPS=ops
DEV_ACCOUNT=ACCT-001
